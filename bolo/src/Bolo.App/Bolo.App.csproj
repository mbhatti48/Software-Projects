<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Bolo</AssemblyName>
    <ApplicationIcon>Assets\bolo.ico</ApplicationIcon>
    <Version>1.3.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bolo.Core\Bolo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cinzel (titles, wordmark) and Nunito (text), SIL OFL; static instances because WPF has no variable-font support. -->
    <Resource Include="Assets\Fonts\*.ttf" />
    <!-- The logo at 1024 px for the sidebar wordmark and onboarding; the .ico above carries the small sizes. -->
    <Resource Include="Assets\bolo-logo.png" />
  </ItemGroup>

</Project>
